---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { asset, emphasize, homePath, loadContent, ui, type Lang } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const c = await loadContent();
const { profile, hero, services, process, about, contact, projects } = c;
const photo = asset(profile.photo);
const site = Astro.site!;
const wa = profile.whatsapp
  ? `https://wa.me/${profile.whatsapp}?text=${encodeURIComponent(profile.whatsappMessage[lang])}`
  : null;

const sections = [
  { id: 'work', dot: '--a-sky' },
  { id: 'services', dot: '--a-sage' },
  { id: 'process', dot: '--a-sand' },
  { id: 'about', dot: '--a-rose' },
  { id: 'contact', dot: '--a-lilac' },
] as const;

const icons = {
  screen: '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 9h18M8 21h8"/>',
  dashboard: '<path d="M4 4h16v16H4zM4 9h16M9 9v11"/>',
  globe: '<path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/>',
};
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
const external = '<path d="M7 17 17 7M8 7h9v9"/>';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role[lang],
  url: new URL(homePath(lang), site).href,
  ...(photo && { image: new URL(photo.src, site).href }),
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressCountry: 'ID' },
  sameAs: [profile.linkedin, profile.github].filter(Boolean),
};
---

<Base
  lang={lang}
  title={profile.seoTitle[lang]}
  description={profile.seoDescription[lang]}
  image={photo?.src}
  jsonLd={jsonLd}
>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="top">
    <div class="wrap">
      <a class="brand" href="#"><i aria-hidden="true"></i>{profile.shortName}</a>
      <nav class="topnav" aria-label="Primary">
        {sections.map((s) => <a href={`#${s.id}`}>{t.nav[s.id]}</a>)}
      </nav>
      <nav class="lang" aria-label={t.language}>
        <a href="/id/" hreflang="id" lang="id" aria-current={lang === 'id' ? 'page' : undefined}>ID</a>
        <a href="/" hreflang="en" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      </nav>
      <button class="toggle" type="button" onclick="toggleTheme()" aria-label={t.themeToggle}>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg
        >
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
        >
      </button>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap">
        <div>
          {hero.available && <p class="status">{hero.status[lang]}</p>}
          <h1 id="hero-title" set:html={emphasize(hero.title[lang])} />
          <p class="lead">{hero.lead[lang]}</p>
          <div class="ctas">
            <a class="btn solid" href="#contact"
              >{t.ctaStart}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a
            >
            <a class="btn" href="#work">{t.ctaWork}</a>
          </div>
          <div class="proof" aria-label={t.highlights}>
            {hero.proof.map((p) => <div><b>{p.value[lang]}</b>{p.text[lang]}</div>)}
          </div>
        </div>
        <div class="stack">
          <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
          {
            photo && (
              <Picture
                src={photo}
                formats={['avif', 'webp']}
                widths={[320, 480, 640, 840]}
                sizes="(max-width: 820px) 300px, 420px"
                alt={profile.photoAlt[lang]}
                loading="eager"
                fetchpriority="high"
              />
            )
          }
          {profile.location && <p class="loc"><b>{profile.name}</b>{profile.location}</p>}
        </div>
      </div>
    </section>

    <section class="band" id="work" aria-labelledby="work-title">
      <div class="wrap">
        <p class="num" aria-hidden="true">01</p>
        <div>
          <p class="label">01 / {t.workLabel}</p>
          <h2 id="work-title">{t.nav.work}</h2>
          <p class="intro">{t.workIntro}</p>
          <div class="cards">
            {
              projects.map(({ entry: p }) => {
                const shot = asset(p.image);
                return (
                  <article class="card">
                    {shot && <Picture src={shot} formats={['avif', 'webp']} widths={[400, 800]} sizes="(max-width: 820px) 100vw, 560px" alt="" class="shot" />}
                    {p.stack.length > 0 && (
                      <ul class="chips" aria-label={t.technologies}>
                        {p.stack.map((s) => <li>{s}</li>)}
                      </ul>
                    )}
                    <h3>{p.title[lang]}</h3>
                    <dl>
                      <div><dt>{t.problem}</dt><dd>{p.problem[lang]}</dd></div>
                      <div><dt>{t.built}</dt><dd>{p.built[lang]}</dd></div>
                      <div><dt>{t.result}</dt><dd>{p.result[lang]}</dd></div>
                    </dl>
                    {p.repoUrl || p.liveUrl ? (
                      <div class="links">
                        {p.repoUrl && <a class="btn" href={p.repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>}
                        {p.liveUrl && (
                          <a class="btn solid" href={p.liveUrl} target="_blank" rel="noopener noreferrer">
                            {t.live}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={external} />
                          </a>
                        )}
                      </div>
                    ) : (
                      <p class="soon">{t.soon}</p>
                    )}
                  </article>
                );
              })
            }
            <article class="card next">
              <h3>{t.nextTitle}</h3>
              <p class="intro" style="margin:.5rem 0 1rem">{t.nextText}</p>
              <a class="btn solid" href="#contact"
                >{t.nextCta}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a
              >
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="band" id="services" aria-labelledby="svc-title">
      <div class="wrap">
        <p class="num" aria-hidden="true">02</p>
        <div>
          <p class="label">02 / {t.servicesLabel}</p>
          <h2 id="svc-title">{t.nav.services}</h2>
          <p class="intro">{services.intro[lang]}</p>
          <div class="svc">
            {
              services.items.map((s) => (
                <article>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]} />
                  <h3>{s.title[lang]}</h3>
                  <p>{s.description[lang]}</p>
                  <ul>{s.bullets.map((b) => <li>{b[lang]}</li>)}</ul>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="band" id="process" aria-labelledby="proc-title">
      <div class="wrap">
        <p class="num" aria-hidden="true">03</p>
        <div>
          <p class="label">03 / {t.processLabel}</p>
          <h2 id="proc-title">{t.nav.process}</h2>
          <div class="steps">
            {process.steps.map((s) => <article><div><h3>{s.title[lang]}</h3><p>{s.description[lang]}</p></div></article>)}
          </div>
        </div>
      </div>
    </section>

    <section class="band" id="about" aria-labelledby="about-title">
      <div class="wrap">
        <p class="num" aria-hidden="true">04</p>
        <div>
          <p class="label">04 / {t.aboutLabel}</p>
          <h2 id="about-title">{t.nav.about}</h2>
          <div class="about">
            <div>{about.paragraphs.map((p) => <p>{p[lang]}</p>)}</div>
            <dl class="fact">
              {about.facts.map((f) => <div><dt>{f.label[lang]}</dt><dd>{f.value}</dd></div>)}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="band" id="contact" aria-labelledby="contact-title">
      <div class="wrap">
        <p class="num" aria-hidden="true">05</p>
        <div>
          <p class="label">05 / {t.contactLabel}</p>
          <h2 id="contact-title">{contact.heading[lang]}</h2>
          <p class="intro">{contact.intro[lang]}</p>
          <a class="mail" href={`mailto:${profile.email}?subject=${encodeURIComponent(t.mailSubject)}`}>{profile.email}</a>
          <div class="socials">
            {
              wa && (
                <a class="btn solid" href={wa} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 21l1.7-4.6A8.5 8.5 0 1 1 8 19.6z" />
                    <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-2-2l.8-1-1-2z" />
                  </svg>
                  WhatsApp
                </a>
              )
            }
            {
              profile.linkedin && (
                <a class="btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="3" />
                    <path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" />
                  </svg>
                  LinkedIn
                </a>
              )
            }
            {
              profile.github && (
                <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 19c-4 1.5-4-2-6-2.5M15 22v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V22" />
                  </svg>
                  GitHub
                </a>
              )
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <nav class="index" aria-label={t.sectionIndex}>
    <ol>
      {
        sections.map((s, i) => (
          <li>
            <a href={`#${s.id}`} style={`--dot:var(${s.dot})`}>
              <span>
                0{i + 1} {t.nav[s.id]}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <footer class="foot">
    <div class="wrap">
      <p>© {new Date().getFullYear()} {profile.name}</p>
      <a href="#"
        >{t.backTop}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="M12 19V5M6 11l6-6 6 6"></path></svg
        ></a
      >
    </div>
  </footer>

  <script>
    const idx = [...document.querySelectorAll<HTMLAnchorElement>('.index a')];
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (e.isIntersecting)
            idx.forEach((a) =>
              a.hash === '#' + e.target.id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current'),
            );
        }),
      { rootMargin: '-45% 0px -50% 0px' },
    );
    document.querySelectorAll('.band').forEach((s) => io.observe(s));
    localStorage.setItem('lang', document.documentElement.lang);
  </script>
</Base>
